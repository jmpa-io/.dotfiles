#
# A collection of applications & processes to start on boot.
#

# give systemd user services (dunst) the X display, then start the notification daemon.
# without this, dunst.service starts before X is known and fails with "Cannot open X11 display".
exec --no-startup-id /bin/sh -c 'dbus-update-activation-environment --systemd DISPLAY XAUTHORITY && systemctl --user restart dunst'

# run polkit-gnome-authentication-agent-1, which handles auth for GUI applications.
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# run nitrogen, to setup the background wallpaper.
exec --no-startup-id nitrogen --restore

# run clipip, a clipboard manager.
exec --no-startup-id clipit -d

# setup autolock mechanism.
exec --no-startup-id "$HOME/bin/system/xautolock-start.sh"

# apply the GTK cursor theme to X (replaces Manjaro's fix_xcursor).
exec_always --no-startup-id "$HOME/bin/system/set-cursor.sh"

# run compositor, for window effects.
# Kill any existing instance first to avoid stacking on i3 reload.
# Explicitly pass config path to avoid picking up /etc/xdg/picom.conf.
exec_always --no-startup-id /bin/sh -c 'pkill -x picom; sleep 0.5; picom --config "$HOME/.config/picom/picom.conf" -b'

# run volumeicon, for bindings to change volume on keyboard.
exec --no-startup-id volumeicon

# run pulseaudio, for control and configuration of audio.
exec --no-startup-id pulseaudio --start

# run polybar, for a nice bar at the top of the screen on this machine.
exec_always --no-startup-id $HOME/.config/polybar/launch.sh

