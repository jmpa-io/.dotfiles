{
    //Workbench.
    "workbench.colorTheme": "Panda Syntax",
    "workbench.layoutControl.enabled": false,

    // Editor.
    "editor.accessibilitySupport": "off",
    "editor.stickyScroll.enabled": false,
    "editor.rulers": [
        80
    ],
    "editor.fontFamily": "'Fira Code', Menlo, Monaco, 'Courier New', monospace",
    "editor.fontLigatures": true,
    "editor.fontWeight": "400",
    "editor.letterSpacing": 0,
    "window.zoomLevel": -0.3,
    "editor.fontSize": 12,
    "files.encoding": "utf8",
    "editor.tokenColorCustomizations": {
      "textMateRules": [
        {
          "scope": [
            "comment",
            "meta.documentation",
            "punctuation.definition.comment"
          ],
          "settings": {
            "fontStyle": ""
          }
        },
        {
          "scope": "comment",
          "settings": {
            "foreground": "#fa7fd6"
          }
        }
      ]
    },

    // Terminal.
    "terminal.external.osxExec": "iTerm.app",
    "terminal.integrated.fontFamily": "Fira Code",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.unicodeVersion": 14,
    "terminal.integrated.customGlyphs": true,

    // Markdown.
    "makefile.configureOnOpen": false,

    // Git.
    "git.mergeEditor": false,

    // Go.
    "go.useLanguageServer": true,
    "go.toolsManagement.autoUpdate": true,

    // GitHub Actions.
    "github-actions.workflows.pinned.refresh.enabled": false,

    // Extensions.
    "extensions.ignoreRecommendations": true,

    // GitHub Copilot.
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.chat.defaultModel": "claude-sonnet-4-5",

    // Gitlens.
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "gitlens.currentLine.enabled": false,
    "gitlens.codeLens.enabled": false,
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.blame.highlight.enabled": false,
    "gitlens.blame.avatars": false,
    "gitlens.blame.compact": false,
    "editor.codeLens": false,

    // TODO Highlight.
    "todohighlight.keywords": [
      { "text": "PLEASE NOTE", "color": "#C5A3FF", "backgroundColor": "rgba(197,163,255,0.18)", "overviewRulerColor": "#C5A3FF", "isWholeLine": false },
      { "text": "NOTE",        "color": "#C5A3FF", "backgroundColor": "rgba(197,163,255,0.18)", "overviewRulerColor": "#C5A3FF", "isWholeLine": false }
    ],

    // Red Hat Telemetry.
    "redhat.telemetry.enabled": false,
    "vsicons.dontShowNewVersionMessage": true,

    // VSCode Pets.
    "vscode-pets.theme": "forest",
    "vscode-pets.petType": "chicken",

    // Symbols Folders Icon Theme.
    "symbols.folders.associations": {
      "bin": "folder-purple",
      "cf": "folder-yellow",
      "cmd": "folder-green",
      "docs": "folder-blue"
    },

    // Roo.
    "roo-cline.debug": false,
    "roo-cline.allowedCommands": [
      "git log",
      "git diff",
      "git show",
      "node",
      "npm",
      "ls",
      "CI=true make download VERSIONS=123.0.0.1,124.0.0.1 SKIP_LINT=1",
      "pip3 install python-crontab psutil --user",
      "pip3",
      "pip3 install",
      "pip3 install python-crontab",
      "which gh",
      "which",
      "mv",
      "grep",
      "head",
      "wc",
      "git",
      "git rebase --continue",
      "git rebase",
      "npm install playwright",
      "npm install"
    ],
    "roo-cline.deniedCommands": [],
    "hediet.vscode-drawio.resizeImages": null,
    "yaml.disableSchemaDetection": [
      "**/.github/workflows/*.yml",
      "**/.github/workflows/*.yaml",
      "**/.gitea/workflows/*.yml",
      "**/.gitea/workflows/*.yaml",
      "**/.forgejo/workflows/*.yml",
      "**/.forgejo/workflows/*.yaml"
    ]
}
