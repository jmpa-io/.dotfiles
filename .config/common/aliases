#!/usr/bin/env bash
# handles aliases and extensions to commands for our terminal.
# shellcheck disable=SC2154  # $os is exported from .zshenv
# shellcheck disable=SC2162  # read "var?prompt" is zsh syntax — file is sourced by zsh, not executed as bash

# funcs.
die() { echo "$1" >&2; exit "${2:-1}"; }

# $os is exported from .zshenv — no need to re-detect here.

# setup aliases to autojump to previously visited directories.
alias d="dirs -v"
# shellcheck disable=SC2139  # intentional: expands at definition time for cd +N navigation
for index in {0..9}; do alias "$index"="cd +${index}"; done; unset index

# zsh.
alias zsrc='for f in "$HOME/.dotfiles.d/work" "$HOME/.dotfiles.d/aliases" "$HOME/.zshenv" "$HOME/.zshrc" "$HOME/.dotfiles.d/ai-aliases"; do [[ -f "$f" ]] && source "$f"; done'

# Broadcast 'source work config' to all panes in the current tmux session.
# Use after key rotation so all shells pick up the new PORTKEY_API_KEY immediately.
alias b-src='tmux list-panes -a -F "#{pane_id}" | xargs -I{} tmux send-keys -t {} "source ${HOME}/.dotfiles.d/work" Enter'

# Re-source shell config across all tmux panes (or a single pane with -p).
# Usage:
#   t-zsrc          — re-source all panes
#   t-zsrc -p %3   — re-source only pane %3 (safe for testing)
#
# Idle zsh panes: sources config directly.
# Claude panes: sends /exit, waits for zsh to return, sources config, then resumes with claude -c.
#   claude -c resumes the most recent session for that pane's working directory — correct per-pane.
# Skips the current pane (caller handles it via zsrc) and panes running anything else.
t-zsrc() {
  local src_cmd='for f in "$HOME/.dotfiles.d/work" "$HOME/.dotfiles.d/aliases" "$HOME/.zshenv" "$HOME/.zshrc" "$HOME/.dotfiles.d/ai-aliases"; do [[ -f "$f" ]] && source "$f"; done'
  local current_pane target_pane=""
  current_pane=$(tmux display-message -p '#{pane_id}')

  # Parse -p <pane_id> flag.
  if [[ "${1:-}" == "-p" ]]; then
    target_pane="${2:?t-zsrc -p requires a pane ID (e.g. -p %3)}"
  fi

  # Detect if a pane is running claude by checking its child process.
  # tmux pane_current_command always shows 'zsh' since claude runs inside zsh.
  # -x matches exact process name, avoiding false positives from other children.
  _t-zsrc-pane-has-claude() {
    local pane_pid
    pane_pid=$(tmux display-message -p -t "$1" '#{pane_pid}' 2>/dev/null)
    pgrep -P "$pane_pid" -x claude &>/dev/null
  }

  _t-zsrc-handle-pane() {
    local pane_id="$1"
    [[ "$pane_id" == "$current_pane" ]] && return

    if _t-zsrc-pane-has-claude "$pane_id"; then
      # Read cwd and session ID from ~/.claude/sessions/<pid>.json before exiting.
      local pane_pid child_pid pane_cwd session_id session_file
      pane_pid=$(tmux display-message -p -t "$pane_id" '#{pane_pid}' 2>/dev/null)
      child_pid=$(pgrep -P "$pane_pid" -x claude 2>/dev/null)
      session_file="$HOME/.claude/sessions/${child_pid}.json"
      if [[ -f "$session_file" ]]; then
        pane_cwd=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d['cwd'])" "$session_file" 2>/dev/null)
        session_id=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d['sessionId'])" "$session_file" 2>/dev/null)
      fi
      [[ -z "$pane_cwd" ]] && pane_cwd=$(tmux display-message -p -t "$pane_id" '#{pane_current_path}' 2>/dev/null)

      # Clear any partial input, then send /exit.
      tmux send-keys -t "$pane_id" C-c
      sleep 0.05
      tmux send-keys -t "$pane_id" '/exit' Enter

      # Wait up to 15s for claude child process to exit.
      local i=0
      while (( i++ < 150 )); do
        _t-zsrc-pane-has-claude "$pane_id" || break
        sleep 0.1
      done

      # Poll until zsh is the active command (prompt is ready).
      local j=0
      while (( j++ < 50 )); do
        [[ "$(tmux display-message -p -t "$pane_id" '#{pane_current_command}' 2>/dev/null)" == "zsh" ]] && break
        sleep 0.05
      done

      tmux send-keys -l -t "$pane_id" "$src_cmd"
      tmux send-keys -t "$pane_id" Enter
      tmux send-keys -l -t "$pane_id" "cd $(printf '%q' "$pane_cwd")"
      tmux send-keys -t "$pane_id" Enter
      if [[ -n "$session_id" ]]; then
        tmux send-keys -t "$pane_id" "claude --resume $session_id" Enter
      else
        tmux send-keys -t "$pane_id" 'claude -c' Enter
      fi

    else
      # Idle zsh pane — just re-source.
      tmux send-keys -l -t "$pane_id" "$src_cmd"
      tmux send-keys -t "$pane_id" Enter
    fi
  }

  if [[ -n "$target_pane" ]]; then
    _t-zsrc-handle-pane "$target_pane"
  else
    tmux list-panes -a -F '#{pane_id}' | while read -r pane_id; do
      _t-zsrc-handle-pane "$pane_id"
    done
  fi
}

# tmux sessions — each creates or attaches to a named session with a fixed layout.
# Use across multiple screens — attach from any window with the same alias.

# work-1: wide left + 2 stacked right (3 panes) — CBA work session
t-work-1() {
  if ! tmux has-session -t work-1 2>/dev/null; then
    tmux new-session -d -s work-1
    tmux split-window -h -t work-1
    tmux split-window -v -t work-1:1.2
    tmux select-pane -t work-1:1.1
  fi
  tmux attach-session -t work-1
}

# work-2: 2 stacked left + wide right (3 panes) — opposite of work-1
t-work-2() {
  if ! tmux has-session -t work-2 2>/dev/null; then
    tmux new-session -d -s work-2
    tmux split-window -h -t work-2
    tmux split-window -v -t work-2:1.1
    tmux select-pane -t work-2:1.2
  fi
  tmux attach-session -t work-2
}

# work-3: 2 terminals side by side (2 panes) — CBA work session
t-work-3() {
  if ! tmux has-session -t work-3 2>/dev/null; then
    tmux new-session -d -s work-3
    tmux split-window -h -t work-3
    tmux select-pane -t work-3:1.1
  fi
  tmux attach-session -t work-3
}

# work-4: 2 terminals side by side (2 panes) — same as work-3
t-work-4() {
  if ! tmux has-session -t work-4 2>/dev/null; then
    tmux new-session -d -s work-4
    tmux split-window -h -t work-4
    tmux select-pane -t work-4:1.1
  fi
  tmux attach-session -t work-4
}

# work-5: single terminal — clean session
t-work-5() {
  tmux new-session -A -s work-5
}

# homelab: main left + 2 stacked right (3 panes)
t-homelab() {
  if ! tmux has-session -t homelab 2>/dev/null; then
    tmux new-session -d -s homelab
    tmux split-window -h -t homelab
    tmux split-window -v -t homelab:1.2
    tmux select-pane -t homelab:1.1
  fi
  tmux attach-session -t homelab
}

# misc: single pane — clean shell for one-offs
t-misc() { tmux new-session -A -s misc; }

# t-claude [name] [path] — create or attach a task-named Claude session.
# Usage:
#   t-claude deploy ~/go/src/github.com/CBA-General/harrier
#   t-claude rename-user
#   t-claude                   (prompts for name, uses cwd)
# Session name is slugified: spaces → dashes, lowercased.
# If a session already exists, attaches to it.
# When creating, splits into left (Claude) + right (shell) panes.
t-claude() {
  local name="${1:-}"
  local dir="${2:-$(pwd)}"

  if [[ -z "$name" ]]; then
    read "name?Session name: "
    [[ -z "$name" ]] && return 0
  fi

  # slugify
  local slug
  slug=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr ' _/' '-' | tr -cd 'a-z0-9-')
  [[ -z "$slug" ]] && { echo "t-claude: empty slug after sanitising '$name'" >&2; return 1; }

  if ! tmux has-session -t "$slug" 2>/dev/null; then
    tmux new-session -d -s "$slug" -c "$dir"
    tmux split-window -h -t "$slug" -c "$dir"
    tmux select-pane -t "$slug:1.1"
    # Start claude in the left pane.
    tmux send-keys -t "$slug:1.1" 'claude' Enter
  fi
  tmux attach-session -t "$slug"
}

# t-rename [new-name] — rename the current tmux session.
# If new-name is omitted, prompts interactively.
t-rename() {
  local new_name="${1:-}"
  if [[ -z "$new_name" ]]; then
    local current
    current=$(tmux display-message -p '#S' 2>/dev/null)
    read "new_name?New name [${current}]: "
    [[ -z "$new_name" ]] && return 0
  fi
  local slug
  slug=$(echo "$new_name" | tr '[:upper:]' '[:lower:]' | tr ' _/' '-' | tr -cd 'a-z0-9-')
  tmux rename-session "$slug"
  echo "renamed to: $slug"
}

# t-status — list all sessions with pane counts, commands, and attached marker.
t-status() {
  echo
  printf "  %-22s  %-5s  %-8s  %s\n" "SESSION" "PANES" "ATTACHED" "COMMANDS"
  printf "  %-22s  %-5s  %-8s  %s\n" "───────────────────────" "─────" "────────" "────────────────────────────────"
  while IFS=' ' read -r name _windows attached; do
    panes=$(tmux list-panes -s -t "$name" -F '#{pane_id}' 2>/dev/null | wc -l | tr -d ' ')
    cmds=$(tmux list-panes -s -t "$name" -F '#{pane_current_command}' 2>/dev/null \
      | sort | uniq -c | sort -rn \
      | awk '{printf "%s×%s  ", $1, $2}' | sed 's/  $//')
    attached_str=""
    [[ "$attached" -gt 0 ]] && attached_str="●"
    printf "  %-22s  %-5s  %-8s  %s\n" "$name" "$panes" "$attached_str" "$cmds"
  done < <(tmux list-sessions -F '#{session_name} #{session_windows} #{session_attached}' 2>/dev/null)
  echo
}

# list running tmux sessions
alias t-ls='tmux ls 2>/dev/null || echo "No tmux sessions running."'

# print a summary of all tmux aliases and how sessions work
t-help() {
  cat <<'EOF'

  Sessions
  ────────
  t-work-1    work session 1  (3 panes: wide left + 2 stacked right)
  t-work-2    work session 2  (3 panes: 2 stacked left + wide right)
  t-work-3    work session 3  (2 panes: side by side)
  t-work-4    work session 4  (2 panes: side by side)
  t-work-5    work session 5  (single pane)
  t-homelab   homelab         (3 panes: main left + 2 right)
  t-misc      misc            (single pane)

  Task-named sessions
  ───────────────────
  t-claude [name] [path]  create/attach a task-named Claude session (left=claude, right=shell)
  t-rename [name]         rename current session to a new slug

  Utility
  ───────
  t-ls        list running sessions
  t-status    list sessions with pane counts + commands
  t-help      show this help
  b-src       broadcast 'source ~/.dotfiles.d/work' to all panes
  t-zsrc      re-source shell config in all panes (exits + resumes claude panes)

  Recovery
  ────────
  Sessions auto-save every 15 mins via tmux-continuum.
  After a crash or reboot, just run the alias again — it restores.

  Key bindings
  ────────────
  Ctrl+B r          reload tmux config
  Ctrl+B t          floating scratchpad terminal
  Ctrl+B s          fuzzy session switcher (fzf)
  Ctrl+B A          AI session inspector (status/save/restore)
  Ctrl+B y          toggle pane sync (types to all panes)
  Ctrl+\            split right
  Ctrl+G            split down
  Shift+Left/Right  previous/next window
  Alt+Arrow         move between panes

EOF
}

