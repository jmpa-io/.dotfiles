#!/usr/bin/env bash
# handles aliases and extensions to commands for our terminal.
# shellcheck disable=SC2154  # $os is exported from .zshenv
# shellcheck disable=SC2162  # read "var?prompt" is zsh syntax — file is sourced by zsh, not executed as bash

# funcs.
die() {
  echo "$1" >&2
  exit "${2:-1}"
}

# $os is exported from .zshenv — no need to re-detect here.

# setup aliases to autojump to previously visited directories.
alias d="dirs -v"
# shellcheck disable=SC2139  # intentional: expands at definition time for cd +N navigation
for index in {0..9}; do alias "$index"="cd +${index}"; done
unset index

# zsh.
# Shared re-source command (also used by t-zsrc below). $HOME stays unexpanded here —
# it's safe to send verbatim into another tmux pane's zsh, expanding at run time there.
# shellcheck disable=SC2016
_ZSRC_CMD='unset _WORK_SOURCED; for f in "$HOME/.dotfiles.d/work" "$HOME/.dotfiles.d/aliases" "$HOME/.dotfiles.d/wt" "$HOME/.zshenv" "$HOME/.zshrc" "$HOME/.dotfiles.d/ai-aliases"; do [[ -f "$f" ]] && source "$f"; done'
alias zsrc="$_ZSRC_CMD"


# Re-source shell config across all tmux panes (or a single pane with -p).
# Usage:
#   t-zsrc          — re-source all panes
#   t-zsrc -p %3   — re-source only pane %3 (safe for testing)
#
# Idle zsh panes: sources config directly.
# Claude panes: sends /exit, waits for zsh to return, sources config, then resumes with claude -c.
#   claude -c resumes the most recent session for that pane's working directory — correct per-pane.
# Skips the current pane (caller handles it via zsrc) and panes running anything else.
t-zsrc() {
  local src_cmd="$_ZSRC_CMD"
  local current_pane target_pane=""
  current_pane=$(tmux display-message -p '#{pane_id}')

  # Parse -p <pane_id> flag.
  if [[ "${1:-}" == "-p" ]]; then
    target_pane="${2:?t-zsrc -p requires a pane ID (e.g. -p %3)}"
  fi

  # Detect if a pane is running claude by checking its child process.
  # tmux pane_current_command always shows 'zsh' since claude runs inside zsh.
  # -x matches exact process name, avoiding false positives from other children.
  _t-zsrc-pane-has-claude() {
    local pane_pid
    pane_pid=$(tmux display-message -p -t "$1" '#{pane_pid}' 2>/dev/null)
    pgrep -P "$pane_pid" -x claude &>/dev/null
  }

  # Detect if a pane is running Copilot CLI. Unlike claude, copilot runs
  # nested (zsh -> node -> copilot binary), so check the full descendant
  # tree, not just the direct child. Matches the "@github/copilot" segment
  # of the npm install path, which is OS/arch-independent (portable across
  # copilot-darwin-arm64, copilot-linux-x64, etc).
  _t-zsrc-pane-has-copilot() {
    local pane_pid target_pid ancestor
    pane_pid=$(tmux display-message -p -t "$1" '#{pane_pid}' 2>/dev/null)
    [[ -z "$pane_pid" ]] && return 1
    for target_pid in $(pgrep -f '@github/copilot' 2>/dev/null); do
      ancestor="$target_pid"
      while [[ -n "$ancestor" && "$ancestor" != "1" && "$ancestor" != "0" ]]; do
        [[ "$ancestor" == "$pane_pid" ]] && return 0
        ancestor=$(ps -o ppid= -p "$ancestor" 2>/dev/null | tr -d ' ')
      done
    done
    return 1
  }

  _t-zsrc-handle-pane() {
    local pane_id="$1"
    [[ "$pane_id" == "$current_pane" ]] && return

    if _t-zsrc-pane-has-claude "$pane_id"; then
      # Read cwd and session ID from ~/.claude/sessions/<pid>.json before exiting.
      local pane_pid child_pid pane_cwd session_id session_file
      pane_pid=$(tmux display-message -p -t "$pane_id" '#{pane_pid}' 2>/dev/null)
      child_pid=$(pgrep -P "$pane_pid" -x claude 2>/dev/null)
      session_file="$HOME/.claude/sessions/${child_pid}.json"
      if [[ -f "$session_file" ]]; then
        pane_cwd=$(jq -r '.cwd // empty' "$session_file" 2>/dev/null)
        session_id=$(jq -r '.sessionId // empty' "$session_file" 2>/dev/null)
      fi
      [[ -z "$pane_cwd" ]] && pane_cwd=$(tmux display-message -p -t "$pane_id" '#{pane_current_path}' 2>/dev/null)

      # Clear any partial input, then send /exit.
      tmux send-keys -t "$pane_id" C-c
      sleep 0.05
      tmux send-keys -t "$pane_id" '/exit' Enter

      # Wait up to 15s for claude child process to exit.
      local i=0
      while ((i++ < 150)); do
        _t-zsrc-pane-has-claude "$pane_id" || break
        sleep 0.1
      done

      # Poll until zsh is the active command (prompt is ready).
      local j=0
      while ((j++ < 50)); do
        [[ "$(tmux display-message -p -t "$pane_id" '#{pane_current_command}' 2>/dev/null)" == "zsh" ]] && break
        sleep 0.05
      done

      tmux send-keys -l -t "$pane_id" "$src_cmd"
      tmux send-keys -t "$pane_id" Enter
      tmux send-keys -l -t "$pane_id" "cd $(printf '%q' "$pane_cwd")"
      tmux send-keys -t "$pane_id" Enter
      if [[ -n "$session_id" ]]; then
        tmux send-keys -t "$pane_id" "claude --resume $session_id" Enter
      else
        tmux send-keys -t "$pane_id" 'claude -c' Enter
      fi

    elif _t-zsrc-pane-has-copilot "$pane_id"; then
      # Copilot has no reliable pane->session-id mapping (unlike claude's
      # ~/.claude/sessions/<pid>.json), so we can't safely auto-exit and
      # resume the correct session. Skip it rather than risk sending text
      # into a live agent conversation. Re-source that pane's shell config
      # yourself later (e.g. `t-zsrc -p <pane_id>` after it's idle, or
      # manually source ~/.zshrc once you exit copilot there).
      echo "t-zsrc: skipping $pane_id — active copilot session (re-source it manually once idle)"

    else
      # Idle zsh pane — just re-source.
      tmux send-keys -l -t "$pane_id" "$src_cmd"
      tmux send-keys -t "$pane_id" Enter
    fi
  }

  if [[ -n "$target_pane" ]]; then
    _t-zsrc-handle-pane "$target_pane"
  else
    tmux list-panes -a -F '#{pane_id}' | while read -r pane_id; do
      _t-zsrc-handle-pane "$pane_id"
    done
  fi
}

# tmux sessions — each creates or attaches to a named session with a fixed layout.
# Use across multiple screens — attach from any window with the same alias.
#
# All layouts reduce to 4 shapes, so the create+split dance lives in one place
# (_t-session-layout) and each named command below just picks a session name + shape.
# shapes: wide-left (wide pane + 2 stacked) | wide-right (mirror of wide-left) |
#         side-by-side (2 panes) | single (1 pane, attach-or-create)
_t-session-layout() {
  local session="$1" shape="$2"

  if [[ "$shape" == "single" ]]; then
    tmux new-session -A -s "$session"
    return
  fi

  if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -d -s "$session"
    case "$shape" in
      wide-left)
        tmux split-window -h -t "$session"
        tmux split-window -v -t "$session:1.2"
        tmux select-pane -t "$session:1.1"
        ;;
      wide-right)
        tmux split-window -h -t "$session"
        tmux split-window -v -t "$session:1.1"
        tmux select-pane -t "$session:1.2"
        ;;
      side-by-side)
        tmux split-window -h -t "$session"
        tmux select-pane -t "$session:1.1"
        ;;
    esac
  fi
  tmux attach-session -t "$session"
}

t-work-1()  { _t-session-layout work-1  wide-left; }     # wide left + 2 stacked right — CBA work session
t-work-2()  { _t-session-layout work-2  wide-right; }    # 2 stacked left + wide right — opposite of work-1
t-work-3()  { _t-session-layout work-3  side-by-side; }  # 2 terminals side by side — CBA work session
t-work-4()  { _t-session-layout work-4  side-by-side; }  # 2 terminals side by side — same shape as work-3
t-work-5()  { _t-session-layout work-5  single; }        # single terminal — clean session
t-homelab() { _t-session-layout homelab wide-left; }     # main left + 2 stacked right
t-misc()    { _t-session-layout misc    single; }        # single pane — clean shell for one-offs

# t-claude [name] [path] — create or attach a task-named Claude session.
# Usage:
#   t-claude deploy ~/go/src/github.com/CBA-General/harrier
#   t-claude rename-user
#   t-claude                   (prompts for name, uses cwd)
# Session name is slugified: spaces → dashes, lowercased.
# If a session already exists, attaches to it.
# When creating, splits into left (Claude) + right (shell) panes.
t-claude() {
  local name="${1:-}"
  local dir="${2:-$(pwd)}"

  if [[ -z "$name" ]]; then
    read "name?Session name: "
    [[ -z "$name" ]] && return 0
  fi

  # slugify
  local slug
  slug=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr ' _/' '-' | tr -cd 'a-z0-9-')
  [[ -z "$slug" ]] && {
    echo "t-claude: empty slug after sanitising '$name'" >&2
    return 1
  }

  if ! tmux has-session -t "$slug" 2>/dev/null; then
    tmux new-session -d -s "$slug" -c "$dir"
    tmux split-window -h -t "$slug" -c "$dir"
    tmux select-pane -t "$slug:1.1"
    # Start claude in the left pane.
    tmux send-keys -t "$slug:1.1" 'claude' Enter
  fi
  tmux attach-session -t "$slug"
}

# t-rename [new-name] — rename the current tmux session.
# If new-name is omitted, prompts interactively.
t-rename() {
  local new_name="${1:-}"
  if [[ -z "$new_name" ]]; then
    local current
    current=$(tmux display-message -p '#S' 2>/dev/null)
    read "new_name?New name [${current}]: "
    [[ -z "$new_name" ]] && return 0
  fi
  local slug
  slug=$(echo "$new_name" | tr '[:upper:]' '[:lower:]' | tr ' _/' '-' | tr -cd 'a-z0-9-')
  tmux rename-session "$slug"
  echo "renamed to: $slug"
}

# t-status — list all sessions with pane counts, commands, and attached marker.
t-status() {
  echo
  printf "  %-22s  %-5s  %-8s  %s\n" "SESSION" "PANES" "ATTACHED" "COMMANDS"
  printf "  %-22s  %-5s  %-8s  %s\n" "───────────────────────" "─────" "────────" "────────────────────────────────"
  while IFS=' ' read -r name _windows attached; do
    panes=$(tmux list-panes -s -t "$name" -F '#{pane_id}' 2>/dev/null | wc -l | tr -d ' ')
    cmds=$(tmux list-panes -s -t "$name" -F '#{pane_current_command}' 2>/dev/null |
      sort | uniq -c | sort -rn |
      awk '{printf "%s×%s  ", $1, $2}' | sed 's/  $//')
    attached_str=""
    [[ "$attached" -gt 0 ]] && attached_str="●"
    printf "  %-22s  %-5s  %-8s  %s\n" "$name" "$panes" "$attached_str" "$cmds"
  done < <(tmux list-sessions -F '#{session_name} #{session_windows} #{session_attached}' 2>/dev/null)
  echo
}

# list running tmux sessions
alias t-ls='tmux ls 2>/dev/null || echo "No tmux sessions running."'

# --- Copilot CLI wrapper: dyld-retry + auto-approve toggle ---
# Auto-retries on transient Homebrew dyld/Gatekeeper EPERM errors:
# "Library not loaded: .../libcrypto.3.dylib ... errno=1"
# Also auto-approves all tools AND auto-trusts the working directory when
# auto-approve mode is on (toggle with `auto-approve` below — shared with the
# claude() wrapper in .ai-aliases). Uses COPILOT_ALLOW_ALL=true (the exact
# string "true"), not just --allow-all-tools, because per `copilot help
# environment`: only the exact "true" value also trusts the working
# directory without prompting — --allow-all-tools alone only covers tool
# confirmations, NOT the "Do you want to allow this?" path/directory trust
# dialog. That dialog is exactly what's risky to leave live: if it's ever
# sent unrelated keystrokes (e.g. by automation), Enter can silently accept
# whichever option is highlighted. Auto-approve now removes that dialog
# entirely rather than relying on never touching it by accident.
# The flag file is checked fresh on every invocation, so toggling it applies
# to new `copilot`/`claude` sessions started in any tmux pane — not just the
# pane where you ran `auto-approve`.
#
# IMPORTANT: stdout stays directly attached to the terminal (not captured) so
# the interactive TUI renders live. Only stderr is duplicated to a temp file
# for dyld-error detection — capturing stdout via command substitution would
# buffer the whole session until exit, making a real interactive session look
# hung forever (it only ever "completed" for quick, non-interactive calls
# like --version).
copilot() {
  local real_copilot="/Users/jordan.cleal/.npm-packages/bin/copilot"
  local -a env_prefix=()
  [[ -f "$HOME/.auto_approve" ]] && env_prefix=(env COPILOT_ALLOW_ALL=true)
  local attempt=1 max=3 rc errfile
  errfile=$(mktemp "${TMPDIR:-/tmp}/copilot-stderr.XXXXXX")
  while (( attempt <= max )); do
    : > "$errfile"
    "${env_prefix[@]}" "$real_copilot" "$@" 2> >(tee "$errfile" >&2)
    rc=$?
    wait
    if [[ $rc -ne 0 ]] && grep -q "dyld.*Library not loaded" "$errfile" 2>/dev/null; then
      (( attempt == max )) && { rm -f "$errfile"; return $rc; }
      sleep 1
      (( attempt++ ))
      continue
    fi
    rm -f "$errfile"
    return $rc
  done
}

# ai — unified launcher: Copilot CLI is the default/priority tool; pass
# 'claude' as the first arg to switch to Claude Code instead for this
# invocation. Both underlying wrappers (copilot()'s dyld-retry logic,
# claude()'s quarantine/auto-approve handling) are preserved untouched —
# this just picks which one to call. Everything after 'claude' is forwarded,
# e.g. `ai claude --resume <id>` or `ai claude -p "..."`.
ai() {
  if [[ "$1" == "claude" ]]; then
    shift
    claude "$@"
  else
    copilot "$@"
  fi
}

# ai-export-context — write the most recent same-directory session from
# either tool's own local store to a markdown file, capped to the last N
# turns (default 15) to keep handoffs cheap. Pure export, no launching —
# used by ai-handoff and safe to run/test standalone.
# Usage: ai-export-context <claude|copilot> [max_turns]
ai-export-context() {
  local source="$1" max="${2:-15}" outfile
  # NOTE: no .md suffix on the template — macOS's BSD mktemp (unlike GNU) does
  # not randomise the X's when a literal suffix follows them, so a suffixed
  # template silently creates the same unrandomised filename every time.
  outfile=$(mktemp "${TMPDIR:-/tmp}/ai-handoff.XXXXXX")
  # Both tools record cwd with symlinks resolved (e.g. /tmp -> /private/tmp on
  # macOS), confirmed by testing — resolve here too or lookups silently miss.
  local real_pwd
  real_pwd=$(cd "$PWD" && pwd -P)
  local safe_pwd="${real_pwd//\'/\'\'}"

  if [[ "$source" == "copilot" ]]; then
    local session_id
    session_id=$(sqlite3 "$HOME/.copilot/session-store.db" \
      "SELECT id FROM sessions WHERE cwd = '$safe_pwd' ORDER BY updated_at DESC LIMIT 1;" 2>/dev/null)
    if [[ -z "$session_id" ]]; then
      echo "ai-export-context: no Copilot session found for $real_pwd" >&2
      rm -f "$outfile"
      return 1
    fi
    {
      echo "# Handoff from Copilot CLI session ($session_id, last $max turns)"
      echo
      sqlite3 -json "$HOME/.copilot/session-store.db" \
        "SELECT turn_index, user_message, assistant_response FROM turns
         WHERE session_id = '$session_id'
         ORDER BY turn_index DESC LIMIT $max;" 2>/dev/null \
        | jq -r 'reverse | .[] | "## Turn \(.turn_index)\n\n**User:** \(.user_message)\n\n**Assistant:** \(.assistant_response // "(no response yet)")\n"'
    } > "$outfile"

  elif [[ "$source" == "claude" ]]; then
    local cwd_encoded session_file
    cwd_encoded=$(echo "$real_pwd" | tr '/.' '-')
    session_file=$(find "$HOME/.claude/projects/$cwd_encoded" -maxdepth 1 -name "*.jsonl" 2>/dev/null \
      -exec stat -f "%m %N" {} \; 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
    if [[ -z "$session_file" ]]; then
      echo "ai-export-context: no Claude session found for $real_pwd" >&2
      rm -f "$outfile"
      return 1
    fi
    {
      echo "# Handoff from Claude Code session ($(basename "$session_file" .jsonl), last $max turns)"
      echo
      jq -rs --argjson max "$max" '
        [.[] | select(.message.role == "user" or .message.role == "assistant")] as $all
        | $all[-($max*2):][]
        | .message as $m
        | ($m.content | if type == "string" then . else ([.[] | select(.type=="text") | .text] | join(" ")) end) as $text
        | select($text != "" and $text != null)
        | "**\($m.role | ascii_upcase):** \($text)\n"
      ' "$session_file" 2>/dev/null
    } > "$outfile"
  else
    echo "usage: ai-export-context <claude|copilot> [max_turns]" >&2
    rm -f "$outfile"
    return 64
  fi

  echo "$outfile"
}

# ai-handoff — export the most recent same-directory session from the OTHER
# tool (capped to recent turns) and launch the target tool seeded with it as
# an interactive first message. This is a one-way, read-only copy — it does
# not touch either tool's real session storage.
# Usage: ai-handoff claude [max_turns]    (bring recent Copilot context into Claude)
#        ai-handoff copilot [max_turns]   (bring recent Claude context into Copilot)
#
# NOTE: the two CLIs seed an interactive first message differently, verified
# live (not just from --help) — claude accepts a bare positional prompt;
# copilot requires -i/--interactive (a bare positional arg errors with
# "Invalid command format" — confirmed by testing, not assumed).
ai-handoff() {
  local target="$1" max="${2:-15}" source outfile
  case "$target" in
    claude) source="copilot" ;;
    copilot) source="claude" ;;
    *) echo "usage: ai-handoff <claude|copilot> [max_turns]" >&2; return 64 ;;
  esac

  outfile=$(ai-export-context "$source" "$max") || return 1
  echo "Handoff context from $source written to $outfile ($(wc -l < "$outfile" | tr -d ' ') lines)"

  local seed
  seed="Continuing a session handed off from $(tr '[:lower:]' '[:upper:]' <<<"${source:0:1}")${source:1}. Prior context below — continue from here:

$(cat "$outfile")"

  if [[ "$target" == "copilot" ]]; then
    copilot -i "$seed"
  else
    claude "$seed"
  fi
}

# auto-approve: toggle auto-approve mode for BOTH Copilot CLI
# (--allow-all-tools) and Claude Code (--permission-mode bypassPermissions)
# for all new sessions across every tmux pane. Run it once to turn on, run it
# again to turn off. Already-running sessions are unaffected.
alias auto-approve='if [[ -f "$HOME/.auto_approve" ]]; then rm -f "$HOME/.auto_approve"; echo "✅ Auto-approve OFF — new copilot/claude sessions require normal approval."; else touch "$HOME/.auto_approve"; echo "⚡ Auto-approve ON — new copilot/claude sessions auto-approve all tools."; fi'

