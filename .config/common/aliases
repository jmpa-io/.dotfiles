# opens the last screenshot taken in Firefox (resolved at invocation time, not source time).
olss() {
  local f
  # shellcheck disable=SC2012  # ls -t is intentional for mtime sort; filenames here won't have newlines
  f=$(ls -1t "$HOME/Pictures" | head -n1)
  [[ -n "$f" ]] && firefox "$HOME/Pictures/$f"
}

# Writes the active AWS_PROFILE to ~/.dotfiles.d/work so it persists across new terminals.
# Only writes if ~/.dotfiles.d/work exists — no-op otherwise.
_aws_write_profile_to_work() {
  local profile="$1"
  local work="$HOME/.dotfiles.d/work"
  [[ -f "$work" ]] || return 0
  # Replace existing AWS_PROFILE line or append if not present.
  if grep -q "^export AWS_PROFILE=" "$work"; then
    if [[ "$os" == "Darwin" ]]; then
      sed -i '' "s|^export AWS_PROFILE=.*|export AWS_PROFILE=\"$profile\"|" "$work"
    else
      sed -i "s|^export AWS_PROFILE=.*|export AWS_PROFILE=\"$profile\"|" "$work"
    fi
  else
    echo "export AWS_PROFILE=\"$profile\"" >> "$work"
  fi
}

# aws overrides.
aws() {
  case $* in

    # what is the AWS IAM Role I am authed to?
    auth)
      command aws sts get-caller-identity ;;

    # what is the ARN of the AWS IAM Role I am authed as?
    who)
      command aws sts get-caller-identity --query "Arn" --output text ;;

    # list ALL the AWS profiles available, including which one is currently authed.
    profiles)
      local profile="${AWS_PROFILE:-default}"
      command aws --no-cli-pager configure list-profiles | while IFS= read -r p; do
        # Skip -admin profiles as they're just for role assumption.
        [[ "$p" == *-admin ]] && continue
        # Show * for both the profile and its -admin variant
        prefix="  "
        [[ "$p" == "$profile" || "${p}-admin" == "$profile" ]] && prefix=" *"
        echo "$prefix $p"
      done
      ;;

     # resets the AWS_PROFILE to the default profile.
    "profile clear")
      export AWS_PROFILE="default"
      _aws_write_profile_to_work "default"
      ;;

    # logs into the AWS Account associated with the given profile.
    # supports --no-browser flag for remote/headless login (prints URL instead of opening browser).
    "login "*)
      local profile=""
      local no_browser=0
      for arg in "${@:2}"; do
        [[ "$arg" == "--no-browser" ]] && no_browser=1 || profile="$arg"
      done

      local profiles_list
      profiles_list=$(command aws --no-cli-pager configure list-profiles)

      if ! printf '%s\n' "$profiles_list" | grep -q "^${profile}$"; then
        echo "'$profile' is not a valid AWS profile; Run 'aws profiles' to see a list of profiles."
        return 1
      fi

      if [[ "$no_browser" == 1 ]]; then
        command aws sso login --profile "$profile" --no-browser
      else
        command aws sso login --profile "$profile"
      fi

      # Check if there's a corresponding -admin profile and use that instead
      local admin_profile="${profile}-admin"
      if printf '%s\n' "$profiles_list" | grep -q "^${admin_profile}$"; then
        export AWS_PROFILE="$admin_profile"
        _aws_write_profile_to_work "$admin_profile"
        echo "Switched to admin profile: $admin_profile"
      else
        export AWS_PROFILE="$profile"
        _aws_write_profile_to_work "$profile"
        echo "Using profile: $profile"
      fi
      ;;

    # a quick way to auth to the given AWS ECR repository, using the ARN.
    "ecr "*.dkr.ecr.*.amazonaws.com*)
      command aws ecr get-login-password --region "${AWS_DEFAULT_REGION:-ap-southeast-2}" | docker login --username AWS --password-stdin "$2" ;;

    # run the default command, if none of the above are applicable.
    *)
      command aws "$@" ;;
  esac
}

# git overrides.
git() {
  case $* in

    # checks who the current gh user is, and what git identity will be used for commits.
    "who")
      local gh_user gh_protocol name email name_src email_src y r
      y=$'\033[1;33m'
      r=$'\033[0m'
      local gh_json
      gh_json=$(command gh auth status --active --json hosts 2>/dev/null)
      gh_user=$(printf '%s' "$gh_json" | jq -r '.hosts."github.com"[0].login // "(not logged in)"')
      gh_protocol=$(printf '%s' "$gh_json" | jq -r '.hosts."github.com"[0].gitProtocol // "(unknown)"')
      name=$(command git config user.name 2>/dev/null || echo "(not set)")
      email=$(command git config user.email 2>/dev/null || echo "(not set)")
      name_src=$(command git config --show-origin user.name 2>/dev/null | cut -f1 | sed 's|file:||' | sed "s|$HOME|~|" || echo "(not set)")
      email_src=$(command git config --show-origin user.email 2>/dev/null | cut -f1 | sed 's|file:||' | sed "s|$HOME|~|" || echo "(not set)")
      printf "\n"
      printf "  gh auth (cli)      %s  (${y}%s${r})\n" "$gh_user" "$gh_protocol"
      printf "  commit author      %s  (${y}%s${r})\n" "$name" "$name_src"
      printf "  commit email       %s  (${y}%s${r})\n" "$email" "$email_src"
      printf "\n"
      ;;

    # switch between gh accounts (avoids colliding with `git switch` branch command).
    "gh-switch")
      command gh auth switch
      case "$os" in
        Darwin)
          git credential-osxkeychain erase <<< "protocol=https
host=github.com" 2>/dev/null || true
          ;;
        Linux)
          git credential reject <<< "protocol=https
host=github.com" 2>/dev/null || true
          ;;
      esac
      ;;

    # runs 'git pull' while pruning old branches.
    pull|"pull "*)
      command git pull --prune "${@:2}" ;;

    # runs 'git clone' and then changes into the directory cloned.
    "clone "*)
      local args=("${@:2}")
      local dest="${args[-1]}"
      # derive dir name from URL (handles extra flags like --depth 1).
      [[ "$dest" == *"://"* || "$dest" == *"@"* ]] && dest="$(basename "$dest" .git)"
      command git clone "${args[@]}" && { cd "$dest" || return 1; } ;;

    # shows all the branches available.
    branch)
      command git branch --all ;;

    # opens the repository in the default browser.
    "open")
      local url
      url=$(command git remote get-url origin \
        | sed -E 's|git@github\.com:|https://github.com/|' \
        | sed -E 's|\.git$||')
      case "$os" in
        Darwin)
          open "$url"
          ;;
        Linux)
          xdg-open "$url"
          ;;
      esac
      ;;

    # run the default command, if none of the above are applicable.
    *)
      command git "$@" ;;
  esac
}

# wt — git worktree manager.
# Usage:
#   wt          interactive picker: add, switch, or remove a worktree
#   wt cd       interactive fzf picker: cd into an existing worktree
#   wt switch   alias for wt cd
#   wt add      create a new worktree
#   wt rm       remove a worktree
#   wt ls       list worktrees
wt() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null)
  if [[ -z "$root" ]]; then
    echo "wt: not inside a git repo" >&2
    return 1
  fi

  # ensure .worktrees/ is gitignored — only in repos we own (under $ROOT).
  if [[ "$root" == "$ROOT"* ]] && ! grep -qxF '.worktrees/' "$root/.gitignore" 2>/dev/null; then
    echo '.worktrees/' >> "$root/.gitignore"
    echo "wt: added .worktrees/ to $root/.gitignore"
  fi

  # helper: build a worktree from a branch name.
  _wt_add() {
    local branch="$1"
    local worktree_path="$root/.worktrees/$branch"
    mkdir -p "$(dirname "$worktree_path")"
    if git -C "$root" branch --list "$branch" | grep -qxF "$branch"; then
      git -C "$root" worktree add "$worktree_path" "$branch"
    else
      git -C "$root" worktree add "$worktree_path" -b "$branch"
    fi
  }

  # helper: pick an existing worktree (excluding current) and cd into it.
  _wt_pick_cd() {
    local current
    current=$(pwd -P)
    local entries
    entries=$(git -C "$root" worktree list --porcelain | awk -v cur="$current" '
      /^worktree / { path=$2; branch=""; sha="" }
      /^HEAD /     { sha=substr($2,1,7) }
      /^branch /   { branch=$2; gsub("refs/heads/","",branch) }
      /^$/ {
        if (path != "" && path != cur) {
          if (branch != "") printf "%s  (%s)\n", path, branch
          else if (sha != "") printf "%s  (detached @ %s)\n", path, sha
        }
        path=""; branch=""; sha=""
      }
    ')
    if [[ -z "$entries" ]]; then
      echo "wt: no other worktrees to switch to" >&2
      return 1
    fi
    local selected
    if command -v fzf &>/dev/null; then
      selected=$(echo "$entries" | fzf --prompt="switch > " --height=40% --border --header="Switch to worktree")
    else
      echo "$entries"
      read "selected?Path to switch to: "
    fi
    [[ -z "$selected" ]] && return 1
    # extract path (first field before the two-space separator)
    local target_path
    target_path=$(echo "$selected" | awk '{ print $1 }')
    echo "$target_path"
  }

  # helper: pick an existing non-current worktree to remove.
  # prints "branch:path" to stdout so the caller doesn't need a second lookup.
  _wt_pick_rm() {
    local removable
    removable=$(git -C "$root" worktree list --porcelain | awk -v root="$root" '
      /^worktree / { path=$2; branch=""; sha="" }
      /^HEAD /     { sha=substr($2,1,7) }
      /^branch /   { branch=$2; gsub("refs/heads/","",branch) }
      /^$/ {
        if (path != "" && path != root) {
          if (branch != "") printf "%s\t%s\n", branch, path
          else if (sha != "") printf "(detached @ %s)\t%s\n", sha, path
        }
        path=""; branch=""; sha=""
      }
    ')
    if [[ -z "$removable" ]]; then
      echo "wt: no worktrees to remove" >&2
      return 1
    fi
    local selected
    if command -v fzf &>/dev/null; then
      selected=$(printf '%s\n' "$removable" | awk -F'\t' '{print $1}' | fzf --prompt="remove > " --height=40% --border --header="Select worktree to remove")
    else
      printf '%s\n' "$removable" | awk -F'\t' '{print $1}'
      local branch
      read "branch?Branch to remove: "
      selected="$branch"
    fi
    [[ -z "$selected" ]] && return 1
    printf '%s\n' "$removable" | awk -F'\t' -v sel="$selected" '$1 == sel { print $1 ":" $2 }'
  }

  case "${1:-}" in

    cd|switch)
      local target_path
      target_path=$(_wt_pick_cd) || return 0
      cd "$target_path" || return 1
      ;;

    ls)
      git -C "$root" worktree list
      ;;

    add)
      local branch="${2:-}"
      if [[ -z "$branch" ]]; then
        read "branch?Branch name (new or existing): "
        [[ -z "$branch" ]] && return 0
      fi
      _wt_add "$branch"
      ;;

    rm)
      local branch="${2:-}"
      local remove_path
      if [[ -z "$branch" ]]; then
        local picked
        picked=$(_wt_pick_rm) || return 0
        branch="${picked%%:*}"
        remove_path="${picked#*:}"
      else
        remove_path=$(git -C "$root" worktree list --porcelain | awk -v branch="refs/heads/$branch" '
          /^worktree / { path=$2 }
          /^branch /   { if ($2 == branch) print path }
        ')
      fi
      if [[ -z "$remove_path" ]]; then
        echo "wt: no worktree found for branch '$branch'" >&2
        return 1
      fi
      git -C "$root" worktree remove "$remove_path"
      echo "wt: removed worktree for '$branch'"
      # offer to delete the local branch too
      local reply
      read "reply?Delete local branch '$branch'? [y/N] "
      if [[ "$reply" =~ ^[Yy]$ ]]; then
        if git -C "$root" branch -d "$branch" 2>/dev/null; then
          echo "wt: deleted branch '$branch'"
        else
          echo "wt: branch '$branch' not fully merged — use 'git branch -D $branch' to force delete" >&2
        fi
      fi
      ;;

    "")
      # no args — interactive picker: add or remove.
      if ! command -v fzf &>/dev/null; then
        echo "wt: fzf not available, use 'wt add' or 'wt rm'" >&2
        return 1
      fi
      local action
      action=$(printf 'switch\nadd\nremove' | fzf \
        --prompt="wt > " \
        --height=20% \
        --border \
        --header="Worktree action")
      [[ -z "$action" ]] && return 0
      case "$action" in
        switch) wt cd  ;;
        add)    wt add ;;
        remove) wt rm  ;;
      esac
      ;;

    *)
      echo "usage: wt [ls | cd | switch | add [branch] | rm [branch]]" >&2
      return 1
      ;;
  esac
}
