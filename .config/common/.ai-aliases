#!/usr/bin/env bash
# AI tool launchers — sourced conditionally by .zshrc only when claude is present.
# Safe to omit on machines without Claude Code.

# claude — launcher with quarantine auto-removal on macOS, plus auto-approve
# mode support (shared toggle with the copilot() wrapper in common/aliases —
# run `auto-approve` to flip it for both tools, in any tmux pane).
# Worktree selection is a shell concern — use 'wt cd' before invoking.
claude() {
  local bin
  bin=$(whence -p claude)

  if xattr -p com.apple.quarantine "$bin" &>/dev/null; then
    if ! xattr -d com.apple.quarantine "$bin" 2>/dev/null; then
      echo "claude: failed to clear quarantine on $bin — run: sudo xattr -d com.apple.quarantine $bin" >&2
    fi
  fi

  local -a extra_args=()
  [[ -f "$HOME/.auto_approve" ]] && extra_args=(--permission-mode bypassPermissions)

  command claude "${extra_args[@]}" "$@"
}

